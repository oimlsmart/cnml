---
/**
 * CNML trust-chain hero visual.
 *
 * The SVG lives at public/img/cnml-trust-chain.svg so it can be
 * edited in any SVG editor (Illustrator, Figma, Inkscape, text
 * editor). This component imports it raw and renders it inline
 * so CSS variables and the .dark class still apply.
 */
import svgRaw from '../../public/img/cnml-trust-chain.svg?raw';

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const svgWithClass = svgRaw.replace('<svg', `<svg class="cnml-seal ${className}"`);
---
<Fragment set:html={svgWithClass} />
