---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { nestedMarkdownStaticPaths, readMarkdownPage, renderMarkdownBody, contentDirFrom } from '../../lib/markdown-page';
import { extractToc } from '../../lib/toc';
import { readingTimeMinutes } from '../../lib/reading-time';
import { sections } from '../../data/docs-sections';
import DocsReadingAffordances from '../../islands/docs/DocsReadingAffordances.vue';
import DocsToc from '../../islands/docs/DocsToc.vue';

export const getStaticPaths = () =>
  nestedMarkdownStaticPaths(contentDirFrom(import.meta.url, 'src/content/docs'));

const slug = Astro.params.slug!;
// Directory part of the slug (everything except the leaf page name).
// A slug of "architecture/system" resolves to directory
// "/docs/architecture/", so sibling links ("../foo") and bare slugs
// ("bar") resolve against that.
const currentDir = '/docs/' + (slug.includes('/') ? slug.slice(0, slug.lastIndexOf('/') + 1) : '');
const page = readMarkdownPage({
  params: Astro.params,
  contentDir: contentDirFrom(import.meta.url, 'src/content/docs'),
  urlDir: currentDir,
});

// Shiki code highlighting + glossary term auto-linking (TODOs 43, 45).
// Async because Shiki loads its themes/grammars at first use.
const rendered = await renderMarkdownBody(page.html);

// Flatten the sections array into an ordered list of docs with section
// context, then locate the current page to compute prev/next and the
// breadcrumb trail.
type FlatDoc = { slug: string; title: string; section: string };
const flat: FlatDoc[] = sections.flatMap((s) =>
  s.docs.map((d) => ({ ...d, section: s.title })),
);
const currentIndex = flat.findIndex((d) => d.slug === slug);
const current = currentIndex >= 0 ? flat[currentIndex] : null;
const prevDoc = currentIndex > 0 ? flat[currentIndex - 1] : null;
const nextDoc = currentIndex >= 0 && currentIndex < flat.length - 1 ? flat[currentIndex + 1] : null;
const section = current?.section ?? 'Documentation';
const tags = ['CNML', 'OIML', 'legal metrology', section];

// Reading-time estimate (TODO 44) and TOC (TODO 42).
const minutes = readingTimeMinutes(page.body);
const toc = extractToc(page.body);
---

<Base
  title={`${page.title} · Docs`}
  description={`CNML documentation: ${page.title}.`}
  article={{ section, tags }}
>
  <DocsReadingAffordances client:visible />
  <script>
    import { mountCodeCopy } from '../../lib/code-copy';
    mountCodeCopy();
  </script>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <a href={url('/docs')} class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">← Docs</a>
    {current && (
      <p class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold mt-6 mb-2">
        <a href={url('/docs')} class="hover:text-[var(--accent)]">{current.section}</a>
      </p>
    )}
    <h1 class="font-serif text-3xl font-semibold text-[var(--ink)] mt-1 mb-2">{page.title}</h1>
    <p class="text-xs text-[var(--ink-muted)] mb-6 font-mono">
      {minutes} min read · {section}
    </p>

    {toc.length >= 2 && (
      <nav class="cnml-card p-4 mb-8 lg:hidden" aria-label="On this page">
        <DocsToc client:visible entries={toc} />
      </nav>
    )}

    <div class="docs-body grid lg:grid-cols-[1fr_180px] gap-8">
      <div set:html={rendered} />
      {toc.length >= 2 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24 text-sm">
            <DocsToc client:visible entries={toc} variant="sticky" />
          </div>
        </aside>
      )}
    </div>

    {(prevDoc || nextDoc) && (
      <nav class="mt-12 pt-6 border-t border-[var(--rule)] grid grid-cols-2 gap-4" aria-label="Doc navigation">
        {prevDoc ? (
          <a href={url(`/docs/${prevDoc.slug}`)}
             class="cnml-card p-4 hover:bg-[var(--accent-soft)] transition-colors">
            <div class="text-xs uppercase tracking-wider text-[var(--ink-muted)] mb-1">← Previous</div>
            <div class="font-semibold text-[var(--ink)]">{prevDoc.title}</div>
            <div class="text-xs text-[var(--ink-muted)] mt-1">{prevDoc.section}</div>
          </a>
        ) : <span />}
        {nextDoc ? (
          <a href={url(`/docs/${nextDoc.slug}`)}
             class="cnml-card p-4 hover:bg-[var(--accent-soft)] transition-colors text-right">
            <div class="text-xs uppercase tracking-wider text-[var(--ink-muted)] mb-1">Next →</div>
            <div class="font-semibold text-[var(--ink)]">{nextDoc.title}</div>
            <div class="text-xs text-[var(--ink-muted)] mt-1">{nextDoc.section}</div>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</Base>
