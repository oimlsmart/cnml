---
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { join } from 'node:path';
import { marked } from 'marked';

const BASE = import.meta.env.BASE_URL;
const url = (path: string) => `${BASE}${path.replace(/^\//, '')}`;

// Mirror of the sections array in docs.astro. The two must stay in sync;
// the canonical source is docs.astro. Duplicated here so doc pages can
// compute prev/next navigation without a cross-page import.
const sections = [
  {
    title: 'Overview',
    docs: [
      { slug: 'what-is-cnml', title: 'What is CNML' },
      { slug: 'why-cnml', title: 'Why CNML' },
    ],
  },
  {
    title: 'Concepts',
    docs: [
      { slug: 'concepts/oiml-institutions', title: 'OIML, BIML, CIML, and OIML-CS' },
      { slug: 'concepts/threshold-cryptography', title: 'Threshold cryptography in CNML' },
      { slug: 'concepts/nist-threshold-alignment', title: 'Alignment with NIST threshold cryptography research' },
      { slug: 'concepts/cnml-and-dcc', title: 'CNML and PTB DCC' },
      { slug: 'concepts/fair-and-dcoc', title: 'FAIR principles and D-CoC' },
      { slug: 'concepts/bipm-digital-si', title: 'BIPM Digital SI and measurement units in CNML' },
    ],
  },
  {
    title: 'Architecture',
    docs: [
      { slug: 'architecture/system', title: 'System architecture' },
      { slug: 'architecture/cnml-vs-typical-pki', title: 'CNML and typical PKI compared' },
      { slug: 'architecture/cnml-architecture-choices', title: 'CNML architecture choices' },
      { slug: 'architecture/distributed-management', title: 'Distributed management' },
      { slug: 'architecture/redundancy', title: 'Redundancy and continuity' },
      { slug: 'architecture/transparency', title: 'Transparency and audit' },
      { slug: 'architecture/hardware-tiers', title: 'Hardware key tiers' },
      { slug: 'architecture/confium-integration', title: 'Confium integration' },
    ],
  },
  {
    title: 'Implementation',
    docs: [
      { slug: 'implementation/schema-driven-design', title: 'Schema-driven design' },
      { slug: 'implementation/verification-pipeline', title: 'Verification pipeline' },
      { slug: 'implementation/dcoc-output', title: 'D-CoC output and FAIR interchange' },
      { slug: 'implementation/internationalization', title: 'Internationalization' },
    ],
  },
  {
    title: 'Roles',
    docs: [
      { slug: 'roles/for-ias-biml-ciml', title: 'For IAs and BIML/CIML' },
      { slug: 'roles/for-verifiers', title: 'For verifiers' },
      { slug: 'roles/for-developers', title: 'For developers' },
    ],
  },
  {
    title: 'Reference',
    docs: [
      { slug: 'reference/glossary', title: 'Glossary' },
      { slug: 'reference/faq', title: 'FAQ' },
      { slug: 'reference/standards-index', title: 'Standards index' },
    ],
  },
];

export function getStaticPaths() {
  const here = fileURLToPath(import.meta.url);
  const docsDir = join(here, '..', '..', '..', '..', 'src', 'content', 'docs');

  // Recursively collect .md files under docs/ and produce slugs that
  // preserve the subdirectory structure. A file at
  // content/docs/concepts/foo.md becomes the slug ['concepts', 'foo'],
  // which Astro renders at /docs/concepts/foo.
  const walk = (dir, base) => {
    const out = [];
    for (const name of readdirSync(dir)) {
      const full = join(dir, name);
      const rel = [...base, name];
      const st = statSync(full);
      if (st.isDirectory()) {
        out.push(...walk(full, rel));
      } else if (name.endsWith('.md')) {
        out.push(rel.slice(0, -1).concat(name.slice(0, -3)));
      }
    }
    return out;
  };

  return walk(docsDir, []).map((segments) => ({
    params: { slug: segments.join('/') },
  }));
}

const slug = Astro.params.slug!;
const here = fileURLToPath(import.meta.url);
const mdPath = join(here, '..', '..', '..', '..', 'src', 'content', 'docs', slug) + '.md';

let title = slug;
let html = '<p>Not found.</p>';
if (existsSync(mdPath)) {
  const md = readFileSync(mdPath, 'utf8');
  const lines = md.split('\n');
  const h1Line = lines.find((l) => l.startsWith('# '));
  if (h1Line) title = h1Line.slice(2).trim();
  const h1Idx = lines.findIndex((l) => l.startsWith('# '));
  const body = h1Idx >= 0 ? lines.slice(h1Idx + 1).join('\n') : md;
  // Prefix internal absolute links (href="/docs/...", src="/diagrams/...")
  // with the configured BASE_URL so they resolve under /cnml/ in production.
  const prefix = BASE.endsWith('/') ? BASE : `${BASE}/`;
  html = marked.parse(body).replace(
    /((?:href|src)=")\/(?!\/)/g,
    `$1${prefix}`,
  );
}

// Flatten the sections array into an ordered list of docs with section
// context, then locate the current page to compute prev/next and the
// breadcrumb trail.
type FlatDoc = { slug: string; title: string; section: string };
const flat: FlatDoc[] = sections.flatMap((s) =>
  s.docs.map((d) => ({ ...d, section: s.title })),
);
const currentIndex = flat.findIndex((d) => d.slug === slug);
const current = currentIndex >= 0 ? flat[currentIndex] : null;
const prevDoc = currentIndex > 0 ? flat[currentIndex - 1] : null;
const nextDoc = currentIndex >= 0 && currentIndex < flat.length - 1 ? flat[currentIndex + 1] : null;
---

<Base title={`${title} · Docs · CNML`}>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <a href={url('/docs')} class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">← Docs</a>
    {current && (
      <p class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold mt-6 mb-2">
        <a href={url('/docs')} class="hover:text-[var(--accent)]">{current.section}</a>
      </p>
    )}
    <h1 class="font-serif text-3xl font-semibold text-[var(--ink)] mt-1 mb-4">{title}</h1>
    <div class="docs-body" set:html={html} />
    {(prevDoc || nextDoc) && (
      <nav class="mt-12 pt-6 border-t border-[var(--rule)] grid grid-cols-2 gap-4" aria-label="Doc navigation">
        {prevDoc ? (
          <a href={url(`/docs/${prevDoc.slug}`)}
             class="cnml-card p-4 hover:bg-[var(--accent-soft)] transition-colors">
            <div class="text-xs uppercase tracking-wider text-[var(--ink-muted)] mb-1">← Previous</div>
            <div class="font-semibold text-[var(--ink)]">{prevDoc.title}</div>
            <div class="text-xs text-[var(--ink-muted)] mt-1">{prevDoc.section}</div>
          </a>
        ) : <span />}
        {nextDoc ? (
          <a href={url(`/docs/${nextDoc.slug}`)}
             class="cnml-card p-4 hover:bg-[var(--accent-soft)] transition-colors text-right">
            <div class="text-xs uppercase tracking-wider text-[var(--ink-muted)] mb-1">Next →</div>
            <div class="font-semibold text-[var(--ink)]">{nextDoc.title}</div>
            <div class="text-xs text-[var(--ink-muted)] mt-1">{nextDoc.section}</div>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</Base>
