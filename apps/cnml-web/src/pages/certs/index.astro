---
import Base from '../../layouts/Base.astro';
import { RECOMMENDATIONS } from '@cnml/cnml-schemas';
import { readFileSync, existsSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { join } from 'node:path';
import yaml from 'yaml';

const here = fileURLToPath(import.meta.url);
const certsDir = join(here, '..', '..', '..', '..', 'public', 'certs');

interface CertSummary {
  number: string;
  issuer: string;
  date: string;
  type_designations: string[];
  category: string;
}

// Find the first sample file for each R (cards link to /certs/<r> for ALL samples).
const certByR: Record<string, CertSummary | null> = {};
for (const r of RECOMMENDATIONS) {
  const prefix = `${r.id.toLowerCase()}-sample-`;
  const file = existsSync(certsDir)
    ? readdirSync(certsDir).filter((f) => f.startsWith(prefix) && f.endsWith('.yaml')).sort()[0]
    : undefined;
  if (file) {
    try {
      const data = yaml.parse(readFileSync(join(certsDir, file), 'utf8')) as any;
      certByR[r.id] = {
        number:           data?.certificate?.number ?? '(unnumbered)',
        issuer:           data?.issuing_authority?.name ?? '?',
        date:             data?.certificate?.date_issued ?? '',
        type_designations: data?.certified_type?.type_designations ?? [],
        category:         data?.certified_type?.category ?? r.title,
      };
    } catch {
      certByR[r.id] = null;
    }
  } else {
    certByR[r.id] = null;
  }
}

// Count samples per R
const sampleCount: Record<string, number> = {};
if (existsSync(certsDir)) {
  for (const f of readdirSync(certsDir)) {
    const m = f.match(/^(r\d+)-sample-/);
    if (m) sampleCount[m[1]!.toUpperCase()] = (sampleCount[m[1]!.toUpperCase()] ?? 0) + 1;
  }
}

const byCategory = RECOMMENDATIONS.reduce((acc, r) => {
  const c = r.category;
  if (!acc[c]) acc[c] = [];
  acc[c].push(r);
  return acc;
}, {} as Record<string, typeof RECOMMENDATIONS>);
---

<Base title="Certificates">
  <section class="max-w-7xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl font-semibold text-[var(--ink)] mb-2 tracking-tight">Certificate samples</h1>
    <p class="text-[var(--ink-soft)] mb-10 max-w-3xl">
      Real OIML-CS certificates per Recommendation — up to three samples per R, drawn from the 880-certificate corpus. Click any card to see all samples, view full YAML, or load into the form builder.
    </p>

    {Object.entries(byCategory).map(([category, rs]) => (
      <div class="mb-10">
        <div class="flex items-baseline justify-between mb-4 pb-2 border-b border-[var(--rule)]">
          <h2 class="font-serif text-xl font-semibold text-[var(--accent)]">{category}</h2>
          <span class="font-mono text-xs uppercase tracking-wider text-[var(--ink-muted)]">{rs.length} recommendations</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {rs.map(r => {
            const c = certByR[r.id];
            const n = sampleCount[r.id] ?? 0;
            return (
              <a href={`/certs/${r.id.toLowerCase()}`} class="cnml-card cnml-card-hover block">
                <div class="flex items-baseline justify-between gap-2 mb-2">
                  <span class="font-serif font-semibold text-[var(--accent)] text-lg">{r.id}</span>
                  <span class="font-mono text-xs uppercase tracking-wider text-[var(--ink-muted)]">{n} sample{n === 1 ? '' : 's'}</span>
                </div>
                <div class="text-sm text-[var(--ink-soft)] mb-2">{r.title}</div>
                {c ? (
                  <>
                    <div class="font-mono text-xs text-[var(--ink)] break-all leading-relaxed">{c.number}</div>
                    <div class="text-xs text-[var(--ink-muted)] mt-1">{c.issuer}</div>
                    <div class="text-xs text-[var(--ink-muted)] mt-2 font-mono">
                      {c.type_designations.length > 0 ? `types: ${c.type_designations.slice(0, 3).join(', ')}` : ''}
                    </div>
                  </>
                ) : (
                  <div class="text-sm text-[var(--ink-muted)] italic">No bundled sample.</div>
                )}
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</Base>
