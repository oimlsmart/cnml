---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/url';
import { flatMarkdownStaticPaths, readMarkdownPage, contentDirFrom } from '../../lib/markdown-page';

export const getStaticPaths = () =>
  flatMarkdownStaticPaths(contentDirFrom(import.meta.url, 'src/content/features'));

const page = readMarkdownPage({
  params: Astro.params,
  contentDir: contentDirFrom(import.meta.url, 'src/content/features'),
  urlDir: '/features/',
});
---

<Base title={`${page.title} · Features`} description={page.lede}>
  <PageHero title={page.title} lede={page.lede} coord={page.coord} />
  <article class="mx-auto max-w-3xl px-6 pb-16 docs-body">
    <a href={url('/#capabilities')} class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">← All features</a>
    <div class="mt-8" set:html={page.html} />
  </article>
</Base>
