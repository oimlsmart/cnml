---
import Base from '../layouts/Base.astro';

const BASE = import.meta.env.BASE_URL;
const url = (path: string) => `${BASE}${path.replace(/^\//, '')}`;

const operations = [
  {
    role: 'Issuing Authority',
    title: 'Create a certificate',
    desc: 'Pick an OIML Recommendation, fill in the type-evaluation results, and sign a CNML certificate with a key generated in your browser.',
    href: url('/create'),
    cta: 'Start creating',
  },
  {
    role: 'Issuing Authority',
    title: 'Generate a CSR',
    desc: 'Build a Certificate Signing Request for a new signing key. The CSR binds the public key to the IA identity and is submitted to BIML for the IA intermediate certificate.',
    href: url('/csr'),
    cta: 'Generate a CSR',
  },
  {
    role: 'Issuing Authority',
    title: 'Manage signing keys',
    desc: 'Generate ECDSA P-256 or composite Ed25519 plus ML-DSA-65 keys, import existing PKCS#11-backed keys, export encryped backups, and delete retired keys.',
    href: url('/keys'),
    cta: 'Open key manager',
  },
  {
    role: 'Manufacturer',
    title: 'Issue an instance certificate',
    desc: 'Sign a per-device instance certificate (tier 5) for each instrument produced, using a manufacturer-held delegated key generated in the browser. Produces a QR code and a downloadable certificate bundle.',
    href: url('/issue/manufacturer-instance'),
    cta: 'Issue instance certificate',
  },
  {
    role: 'Manufacturer',
    title: 'Generate a QR code',
    desc: 'Generate a QR code encoding the passport URL for a CNML instance certificate. The QR code is printed on the device body and resolves to the public passport page when scanned.',
    href: url('/qr-code'),
    cta: 'Open QR generator',
  },
  {
    role: 'Market surveillance, customs, manufacturer',
    title: 'Verify a certificate',
    desc: 'Drop a .cnml.xml file to run the verification pipeline (XML well-formed, schema valid, signature, issuer scope, CRL, timestamp, transparency). Files never leave your browser.',
    href: url('/verify'),
    cta: 'Open verifier',
  },
  {
    role: 'Anyone',
    title: 'Browse sample certificates',
    desc: 'Explore real OIML-CS Type Approval certificates reconstructed in CNML. Three samples per Recommendation are drawn from the published certificate corpus.',
    href: url('/certs'),
    cta: 'Browse samples',
  },
  {
    role: 'Developer',
    title: 'Browse schemas',
    desc: 'View the per-Recommendation JSON Schemas (draft-07) and the XSD that define the CNML certificate model. Each schema is the source of truth for a Recommendation.',
    href: url('/schemas'),
    cta: 'Open schemas',
  },
];

const groupedByRole = operations.reduce((acc, op) => {
  if (!acc[op.role]) acc[op.role] = [];
  acc[op.role].push(op);
  return acc;
}, {} as Record<string, typeof operations>);
---

<Base title="App · CNML">
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <span class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold">CNML Application</span>
    <h1 class="font-serif text-4xl font-semibold text-[var(--ink)] mt-2 mb-4">Certificate operations</h1>
    <p class="text-[var(--ink-soft)] text-lg leading-relaxed max-w-3xl">
      The tools below generate sample CNML certificates for evaluation purposes. They run entirely in your browser. Private keys are generated on device, encrypted with a passphrase-derived key, and never leave your machine. Every operation is stateless on the server.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-16">
    {Object.entries(groupedByRole).map(([role, ops]) => (
      <div class="mb-12">
        <h2 class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold mb-4 border-b border-[var(--rule)] pb-2">{role}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {ops.map(op => (
            <a href={op.href} class="cnml-card cnml-card-hover block">
              <div class="font-semibold text-[var(--ink)] mb-1">{op.title}</div>
              <div class="text-sm text-[var(--ink-muted)] mb-3 leading-relaxed">{op.desc}</div>
              <div class="text-sm font-medium text-[var(--accent)]">{op.cta} →</div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-24 border-t border-[var(--rule)] pt-12">
    <h2 class="font-serif text-2xl font-semibold text-[var(--ink)] mb-4">What these tools do and do not do</h2>
    <div class="space-y-4 text-[var(--ink-soft)] leading-relaxed max-w-3xl">
      <p>
        The tools are designed for evaluation of the CNML format and for prototyping new certificate types. They generate sample CNML certificates signed with locally generated keys. The certificates produced are valid according to the CNML schema and signature pipeline, but they are not OIML-CS type approvals.
      </p>
      <p>
        Production certificate issuance within the OIML-CS framework requires an OIML-Designated Issuing Authority, a hardware key enrolled in the IA's threshold quorum, and a BIML-signed IA intermediate certificate. The tools here do not substitute for that institutional process. They help you understand the format, prototype the data model, and test the verification pipeline.
      </p>
      <p>
        For the full architecture, the five-tier hierarchy, and the site-wide context, see the <a href={url('/docs')} class="text-[var(--accent)] underline">documentation</a>.
      </p>
    </div>
  </section>
</Base>
