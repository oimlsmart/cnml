---
import Base from '../layouts/Base.astro';

const scenarios = [
  {
    num: '01',
    role: 'BIML',
    title: 'Issue a BIML Root certificate',
    desc: 'Generate 7 director keypairs, select 5-of-7 to participate, and produce a threshold-signed sample root certificate. The root is the apex of the CNML trust hierarchy.',
    href: '/issue/biml-root',
    cta: 'Issue root certificate',
  },
  {
    num: '02',
    role: 'Issuing Authority',
    title: 'Issue an IA intermediate certificate',
    desc: 'Pick an OIML Recommendation (for example R60 load cells or R76 weighing instruments), generate the 3-officer quorum, select 2-of-3, and produce a scoped IA intermediate certificate.',
    href: '/issue/ia-intermediate',
    cta: 'Issue IA certificate',
  },
  {
    num: '03',
    role: 'Issuing Authority',
    title: 'Issue a per-Recommendation CNML certificate',
    desc: 'Fill in the measuring instrument details (model, serial, manufacturer, accuracy class), sign with a generated IA signer key, and produce a signed CNML certificate bound to the instrument.',
    href: '/issue/per-recommendation',
    cta: 'Issue CNML certificate',
  },
];

const tools = [
  { href: '/verify',  title: 'Verify a certificate', desc: 'Drop a .cnml.xml file to run the verification pipeline.' },
  { href: '/certs',   title: 'Browse certificates',  desc: 'Explore real OIML-CS sample certificates.' },
  { href: '/schemas', title: 'Browse schemas',       desc: 'View per-Recommendation JSON Schemas.' },
  { href: '/keys',    title: 'Manage keys',           desc: 'Generate, import, and manage signing keys.' },
  { href: '/csr',     title: 'Generate a CSR',        desc: 'Build a Certificate Signing Request.' },
];
---

<Base title="App · CNML">
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <span class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold">CNML Application</span>
    <h1 class="font-serif text-4xl font-semibold text-[var(--ink)] mt-2 mb-4">Certificate operations</h1>
    <p class="text-[var(--ink-soft)] text-lg leading-relaxed max-w-3xl">
      Three certificate issuance scenarios, each on a separate page, each producing a signed
      certificate. Keys are generated in your browser. Files never leave your machine.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-12">
    <h2 class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold mb-4 border-b border-[var(--rule)] pb-2">Certificate issuance scenarios</h2>
    <div class="space-y-4">
      {scenarios.map(s => (
        <a href={s.href} class="cnml-card cnml-card-hover block">
          <div class="flex items-start gap-6">
            <span class="font-mono text-2xl font-semibold text-[var(--accent)] pt-1">{s.num}</span>
            <div class="flex-1">
              <div class="text-xs uppercase tracking-wider text-[var(--ink-muted)] mb-1">{s.role}</div>
              <div class="font-semibold text-[var(--ink)] mb-1">{s.title}</div>
              <div class="text-sm text-[var(--ink-muted)] leading-relaxed">{s.desc}</div>
              <div class="text-sm font-medium text-[var(--accent)] mt-3">{s.cta} →</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-24">
    <h2 class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold mb-4 border-b border-[var(--rule)] pb-2">Tools</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map(t => (
        <a href={t.href} class="cnml-card cnml-card-hover block">
          <div class="font-semibold text-[var(--ink)] mb-1">{t.title}</div>
          <div class="text-sm text-[var(--ink-muted)]">{t.desc}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
