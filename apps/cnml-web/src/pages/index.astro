---
import Base from '../layouts/Base.astro';
import CnmlSeal from '../components/CnmlSeal.astro';

const actions = [
  { num: '01', href: '/create',  title: 'Create',       desc: 'Build a new OIML certificate from a per-Recommendation form. The schema drives the fields; the signer signs with a key in IndexedDB.' },
  { num: '02', href: '/verify',  title: 'Verify',       desc: 'Drop a .cnml.xml file to run the full verification pipeline: well-formed XML, schema, signature, scope, CRL, timestamp, transparency.' },
  { num: '03', href: '/certs',   title: 'Certificates', desc: 'Browse real OIML-CS Type Approval samples. Three samples per Recommendation, drawn from the published certificate corpus.' },
  { num: '04', href: '/schemas', title: 'Schemas',      desc: 'Per-Recommendation JSON Schemas (draft-07) with x-oiml metadata. The schema is the specification; no per-R code exists.' },
  { num: '05', href: '/keys',    title: 'Keys',         desc: 'Generate signing keys, import trusted certificates, manage the trust store. Private keys never leave the browser.' },
  { num: '06', href: '/docs',    title: 'Documentation', desc: 'Twenty-six pages across six sections: overview, concepts, architecture, implementation, roles, reference.' },
];

const spec = [
  { label: 'Recommendations supported', value: '22 OIML R-Recommendations' },
  { label: 'Unit authority',            value: 'BIPM Digital SI via UnitsDB and UnitsML' },
  { label: 'Signature format',          value: 'W3C XMLDSig 1.1 with Exclusive C14N' },
  { label: 'Key algorithms',            value: 'ECDSA P-256; composite Ed25519 with ML-DSA-65' },
  { label: 'Interchange format',        value: 'D-CoC RDF/XML and JSON-LD per NoBoMet V1.2' },
  { label: 'Root-tier quorum',          value: '5-of-7 directors, threshold-signed' },
  { label: 'Transparency',              value: 'Public Merkle log with Bitcoin anchoring' },
  { label: 'Status',                    value: 'Proposal for OIML from the OIML SMART programme' },
];
---

<Base title="CNML">
  <section class="max-w-7xl mx-auto px-6 pt-8">
    <div class="cnml-masthead">
      <div>
        <span class="cnml-masthead__label">Format</span>
        <span class="cnml-masthead__value">CNML</span>
      </div>
      <div>
        <span class="cnml-masthead__label">Programme</span>
        <span class="cnml-masthead__value">OIML SMART</span>
      </div>
      <div>
        <span class="cnml-masthead__label">Edition</span>
        <span class="cnml-masthead__value">2026 (proposal)</span>
      </div>
      <div>
        <span class="cnml-masthead__label">Coverage</span>
        <span class="cnml-masthead__value">22 OIML Recommendations</span>
      </div>
      <div>
        <span class="cnml-masthead__label">Carrier</span>
        <span class="cnml-masthead__value">XML · XMLDSig</span>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-8">
        <span class="cnml-tag mb-4">Certificat Numérique de Métrologie Légale</span>
        <h1 class="cnml-hero__title">
          The OIML SMART programme's digital successor to the PDF certificate of conformity.
        </h1>
        <p class="cnml-hero__lede">
          CNML was developed by analyzing every published OIML-CS Type Approval certificate and digitizing the resulting model in a form compatible with OIML SMART and the relevant OIML R-Recommendations. The format is XML, the signatures are W3C XMLDSig with Exclusive C14N, and the measurement units are anchored to BIPM Digital SI through UnitsDB and UnitsML.
        </p>
      </div>
      <div class="lg:col-span-4">
        <div class="cnml-seal-wrap">
          <CnmlSeal />
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-16">
    <div class="border-t border-[var(--rule)]">
      {actions.map(a => (
        <a href={a.href} class="cnml-clause">
          <span class="cnml-clause__num">{a.num}</span>
          <div>
            <div class="cnml-clause__title">{a.title}</div>
            <div class="cnml-clause__desc">{a.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-16">
    <h2 class="text-xs uppercase tracking-[0.1em] text-[var(--ink-muted)] font-semibold mb-4 border-b border-[var(--rule)] pb-2">Specification</h2>
    <table class="cnml-spec">
      <tbody>
        {spec.map(s => (
          <tr>
            <th>{s.label}</th>
            <td>{s.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>
