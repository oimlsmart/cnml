    <a href="/app" class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">← App</a>
    <h1 class="font-serif text-3xl font-semibold text-[var(--ink)] mt-6 mb-2">Per-Recommendation CNML certificate</h1>
    <p class="text-[var(--ink-muted)] mb-8">Scenario 3 of 3. Bound to instrument details, signed by the IA.</p>
    <PerRecommendationFlow client:load />
