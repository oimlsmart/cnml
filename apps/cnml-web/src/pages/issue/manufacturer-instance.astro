---
import Base from '../../layouts/Base.astro';
import ManufacturerInstanceFlow from '../../islands/issuing/ManufacturerInstanceFlow.vue';
import ErrorBoundary from '../../islands/widgets/ErrorBoundary.vue';
import { url } from '../../lib/url';
import instanceSchema from '@oimlsmart/cnml-schemas/schemas/_instance.yaml';

// The instance certificate schema (_instance.yaml) is the specification
// for the tier-5 cert. The form fields, the XML serializer, and the
// passport projection all derive their field set from this schema.
// See packages/cnml-xml/src/index.ts → instanceCertToXml().
---

<Base title="Manufacturer instance certificate">
  <section class="mx-auto max-w-3xl px-6 py-12">
    <a href={url('/app')} class="text-sm text-[var(--ink-soft)] hover:text-[var(--accent)]">&larr; Back to app</a>
    <h1 class="font-serif text-3xl font-semibold text-[var(--accent)] mt-4 mb-2">Manufacturer instance certificate</h1>
    <p class="text-[var(--ink-soft)] mb-8">
      Scenario 4 of 4. The manufacturer signs a per-device certificate for each instrument they produce.
    </p>
    <ErrorBoundary client:idle>
      <ManufacturerInstanceFlow client:idle schema={instanceSchema} />
    </ErrorBoundary>
  </section>
</Base>
