---
import Base from '../../layouts/Base.astro';
import IaIntermediateFlow from '../../islands/issuing/IaIntermediateFlow.vue';
---

<Base title="Issue IA Intermediate · CNML">
  <section class="max-w-3xl mx-auto px-6 py-12">
    <a href="/app" class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">← App</a>
    <h1 class="font-serif text-3xl font-semibold text-[var(--ink)] mt-6 mb-2">IA intermediate certificate</h1>
    <p class="text-[var(--ink-muted)] mb-8">Scenario 2 of 3. Threshold-signed by 2-of-3 IA officers, scoped to a Recommendation.</p>
    <IaIntermediateFlow client:load />
  </section>
</Base>
