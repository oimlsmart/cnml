---
import Base from '../../layouts/Base.astro';
import BimlRootFlow from '../../islands/issuing/BimlRootFlow.vue';
---

<Base title="Issue BIML Root · CNML">
  <section class="max-w-3xl mx-auto px-6 py-12">
    <a href="/app" class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">← App</a>
    <h1 class="font-serif text-3xl font-semibold text-[var(--ink)] mt-6 mb-2">BIML Root certificate</h1>
    <p class="text-[var(--ink-muted)] mb-8">Scenario 1 of 3. Threshold-signed by 5-of-7 directors.</p>
    <BimlRootFlow client:load />
  </section>
</Base>
