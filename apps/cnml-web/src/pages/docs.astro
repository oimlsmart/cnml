---
import Base from '../layouts/Base.astro';

const sections = [
  { slug: 'what-is-cnml',          title: 'What is CNML?',          desc: 'Overview and comparison with PTB DCC' },
  { slug: 'why-cnml',              title: 'Why CNML',               desc: 'Why Issuing Authorities should adopt this — security pitch, technology stack, robustness guarantees' },
  { slug: 'for-decision-makers',   title: 'For Decision Makers',    desc: 'Executive summary: longevity, security, management, cost — the business case for CNML over current PDF + typical PKI' },
  { slug: 'for-policy-makers',     title: 'For Policy Makers',      desc: 'Treaty-level pitch: sovereignty, non-compellability, mutual recognition framework — for ministers, ambassadors, regulators' },
  { slug: 'administration',        title: 'BIML, CIML & OIML admin', desc: 'Governance model: who decides, who operates, who audits — decision rights, role separation, dispute resolution, operational cadence' },
  { slug: 'use-cases',             title: 'Use cases beyond metrology', desc: 'How the CNML trust framework generalizes — pharma, environmental monitoring, customs, food safety, credentials, medical devices' },
  { slug: 'adoption-roadmap',      title: 'Adoption Roadmap',       desc: '5-year strategy: founding members, network effects, regional expansion, subsidized hardware program' },
  { slug: 'threat-model',          title: 'Threat Model',           desc: 'Formal STRIDE + LINDDUN analysis — attacker capabilities, attack surfaces, defensive controls, residual risk' },
  { slug: 'historical-context',    title: 'Historical Context',     desc: 'DigiNotar, Comodo, Symantec, Sectigo — the historical failures that informed CNML design' },
  { slug: 'comparison-concurrent-efforts', title: 'Vs Concurrent Efforts', desc: 'CNML vs PTB DCC, EU eIDAS, US FPKI, ISO 17025 digital, NIST 800-63, WebTrust, ETSI' },
  { slug: 'environmental-impact',  title: 'Environmental Impact',   desc: 'Carbon footprint analysis, multi-anchor strategy for ESG-friendly deployments' },
  { slug: 'glossary',              title: 'Glossary',               desc: 'Terminology for non-experts — what FROST, ML-KEM, OTS, BIML, IA, TL, DoMC actually mean' },
  { slug: 'faq',                   title: 'FAQ',                    desc: 'Common questions and objections answered' },
  { slug: 'architecture',          title: 'Architecture',           desc: 'CORE + modules + per-R; XSD; BIPM Digital SI (via UnitsML + UnitsDB)' },
  { slug: 'confium-architecture',  title: 'Confium integration',    desc: 'How CNML talks to the Rust confium core — FFI / WASM / TCP binding matrix, capability detection, version contract' },
  { slug: 'dcoc',                  title: 'D-CoC (RDF form)',       desc: 'NoBoMet Digital Certificate of Conformity — FAIR-aligned RDF/XML + JSON-LD output' },
  { slug: 'for-issuers',           title: 'For Issuers',            desc: 'How to create and sign a CNML' },
  { slug: 'for-verifiers',         title: 'For Verifiers',          desc: 'How to verify a CNML and what to check' },
  { slug: 'for-developers',        title: 'For Developers',         desc: 'Repos, build, contribution' },
  { slug: 'cryptography',          title: 'Cryptography',           desc: 'Public/private key system, signing algorithms' },
  { slug: 'trust-model',           title: 'Trust model',            desc: 'Who can issue, OIML DoMC relationship' },
  { slug: 'hardware-keys',         title: 'Hardware-backed keys',   desc: 'Yubikey/HSM/PKCS#11 setup and operational guide' },
  { slug: 'biml-governance',       title: 'BIML scope governance',  desc: 'How each Issuing Authority is cryptographically scoped to specific Recommendations' },
  { slug: 'cnml-vs-typical-pki',   title: 'CNML vs typical PKI',    desc: 'Why an air-gapped, document-signing, scope-governed, threshold-signed PKI looks nothing like web TLS' },
];
---

<Base title="Docs · CNML">
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid grid-cols-12 gap-8">
      <aside class="col-span-3 border-r border-[var(--rule)] pr-6">
        <h2 class="text-xs uppercase tracking-wider text-[var(--ink-muted)] font-semibold mb-3">Contents</h2>
        <ul class="space-y-2 text-sm">
          {sections.map(s => (
            <li><a href={`/docs/${s.slug}`} class="hover:text-[var(--accent)]">{s.title}</a></li>
          ))}
          <li class="pt-3 mt-3 border-t border-[var(--rule)]">
            <a href="/diagrams" class="hover:text-[var(--accent)]">Diagrams gallery</a>
          </li>
        </ul>
      </aside>
      <div class="col-span-9">
        <h1 class="text-4xl font-bold mb-2">CNML Documentation</h1>
        <p class="text-[var(--ink-muted)] mb-10">Everything you need to issue, verify, and trust OIML Digital Legal Metrology Certificates.</p>

        <div class="grid grid-cols-2 gap-4">
          {sections.map(s => (
            <a href={`/docs/${s.slug}`} class="block p-5 rounded-xl border border-[var(--rule)] hover:border-[var(--accent)]">
              <div class="font-semibold mb-1">{s.title}</div>
              <div class="text-sm text-[var(--ink-muted)]">{s.desc}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
