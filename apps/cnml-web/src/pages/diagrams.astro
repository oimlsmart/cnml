---
import Base from '../layouts/Base.astro';

const diagrams = [
  { slug: 'architecture',                    title: 'System Architecture',                desc: 'CNML ecosystem: Ruby source, TS web app, keys, verifier' },
  { slug: 'certificate-layers',              title: 'Certificate Model Layers',           desc: 'CORE to modules to per-R to instance' },
  { slug: 'signing-flow',                    title: 'Signing Flow',                       desc: 'From form to downloadable signed CNML' },
  { slug: 'verification-flow',               title: 'Verification Flow',                  desc: 'Sequential checks with short-circuit failure' },
  { slug: 'trust-chain',                     title: 'Trust Chain',                        desc: 'PKI hierarchy from root through issuer to certificate' },
  { slug: 'unitsml-embedding',               title: 'UnitsML Embedding',                  desc: 'How UnitsDB units are encoded in CNML XML' },
  { slug: 'pki-comparison',                  title: 'PKI: typical TLS vs CNML',           desc: 'Side-by-side architecture comparison' },
  { slug: 'issuance-flow-comparison',        title: 'Issuance flow comparison',           desc: 'ACME-automated versus human-reviewed air-gapped' },
  { slug: 'scope-governance-comparison',     title: 'Scope governance comparison',        desc: 'How CNML cryptographically encodes per-IA authorization' },
  { slug: 'security-architecture',           title: 'Security architecture',              desc: 'Six-layer defense-in-depth view' },
  { slug: 'five-tier-hierarchy',             title: 'Five-tier certificate hierarchy',    desc: 'BIML Root through IA through TL through Manufacturer Model to Instance' },
  { slug: 'async-signing-flow',              title: 'Async signing flow',                 desc: 'Director participation across time zones via the coordinator' },
  { slug: 'distributed-management',          title: 'Distributed management',             desc: 'Geographic distribution of threshold signing authority' },
  { slug: 'redundancy-fault-tolerance',      title: 'Redundancy and fault tolerance',     desc: 'How operations continue under component loss' },
  { slug: 'resharing-recovery',              title: 'Re-sharing and recovery',            desc: 'Director departure preserves the aggregate public key' },
  { slug: 'scope-enforcement-flow',          title: 'Scope enforcement flow',             desc: 'Four-layer enforcement of per-IA per-Recommendation scope' },
  { slug: 'transparency-flow',               title: 'Transparency flow',                  desc: 'Merkle log with mirror agreement and Bitcoin anchor' },
  { slug: 'threshold-encryption-flow',       title: 'Threshold encryption flow',          desc: 'Confidential test report protection via threshold KEM' },
  { slug: 'confium-integration-points',      title: 'Confium integration points',         desc: 'Ruby FFI, browser WASM, and TCP bindings to the threshold core' },
  { slug: 'institutional-architecture',      title: 'Institutional architecture',         desc: 'OIML bodies and their authority relationships' },
];
---

<Base title="Diagrams · CNML">
  <section class="mx-auto max-w-7xl px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">Diagrams</h1>
    <p class="text-[var(--ink-muted)] mb-10">Visual reference for CNML concepts. Click any diagram to view full-size.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {diagrams.map(d => (
        <a href={`/diagrams/${d.slug}.svg`} class="block rounded-2xl border border-[var(--rule)] overflow-hidden hover:border-[var(--accent)]">
          <div class="aspect-video bg-white p-4 grid place-items-center">
            <img src={`/diagrams/${d.slug}.svg`} alt={d.title} class="max-w-full max-h-full" />
          </div>
          <div class="p-4 border-t border-[var(--rule)]">
            <div class="font-semibold">{d.title}</div>
            <div class="text-sm text-[var(--ink-muted)]">{d.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
