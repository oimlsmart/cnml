---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { flatMarkdownStaticPaths, readMarkdownPage, contentDirFrom } from '../../lib/markdown-page';

export const getStaticPaths = () =>
  flatMarkdownStaticPaths(contentDirFrom(import.meta.url, 'src/content/audiences'));

const page = readMarkdownPage({
  params: Astro.params,
  contentDir: contentDirFrom(import.meta.url, 'src/content/audiences'),
  urlDir: '/audiences/',
});
---

<Base title={`${page.title} · Audiences`}>
  <PageHero title={page.title} lede={page.lede} coord={page.coord} />
  <article class="mx-auto max-w-3xl px-6 pb-16 docs-body" set:html={page.html} />
</Base>
