---
import '../styles/global.css';
import PilotWarning from '../components/PilotWarning.astro';
import NavDropdown from '../components/NavDropdown.vue';
import MobileNav from '../components/MobileNav.vue';
import ThemeToggle from '../components/ThemeToggle.vue';
import type { NavDropdownConfig } from '../components/NavDropdown.vue';
import type { MobileNavItem } from '../components/MobileNav.vue';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'CNML', description = 'OIML Certificat Numérique de Métrologie Légale' } = Astro.props;
const pageTitle = title === 'CNML' ? title : `${title} · CNML`;

// Astro rebases <link>, <script>, and asset imports under `base`, but does
// NOT rebase <a href> or <img src> written as absolute paths. Prefix them
// manually with BASE_URL (always ends with "/") so links resolve under
// /cnml/ in production. See TODO.cnml/01-design-system-adoption.md.
const BASE = import.meta.env.BASE_URL; // "/" in dev, "/cnml/" in prod
const url = (path: string) => `${BASE}${path.replace(/^\//, '')}`;

// ─── Primary navigation ──────────────────────────────────────────────
// Three dropdowns (About, Audiences, Features) and two flat links
// (Documentation, App). All hrefs are rebased via url() so they resolve
// under /cnml/ in production. See TODO.cnml/03-navigation-restructure.md.
const aboutDropdown: NavDropdownConfig = {
  id: 'about',
  label: 'About',
  links: [
    { label: 'What is CNML', href: url('/about/what-is-cnml'), desc: 'Concept introduction and scope' },
    { label: 'Why CNML', href: url('/about/why-cnml'), desc: 'The problem CNML solves' },
    { label: 'How it works', href: url('/about/how-it-works'), desc: 'The five-tier hierarchy and verification pipeline' },
    { label: 'Technology', href: url('/about/technology'), desc: 'The standards and cryptographic algorithms' },
    { label: 'Contact', href: url('/about/contact'), desc: 'How to engage with the OIML SMART programme' },
  ],
};

const audiencesDropdown: NavDropdownConfig = {
  id: 'audiences',
  label: 'Audiences',
  links: [
    { label: 'Issuing Authorities', href: url('/audiences/issuing-authorities') },
    { label: 'BIML and CIML', href: url('/audiences/biml-ciml') },
    { label: 'Manufacturers', href: url('/audiences/manufacturers') },
    { label: 'Test laboratories', href: url('/audiences/test-laboratories') },
    { label: 'Verifiers', href: url('/audiences/verifiers') },
    { label: 'Developers', href: url('/audiences/developers') },
  ],
};

const featuresDropdown: NavDropdownConfig = {
  id: 'features',
  label: 'Features',
  links: [
    { label: 'Threshold signing', href: url('/features/threshold-signing') },
    { label: 'Composite signatures', href: url('/features/composite-signatures') },
    { label: 'Scope governance', href: url('/features/scope-governance') },
    { label: 'Transparency', href: url('/features/transparency') },
    { label: 'QR code delivery', href: url('/features/qr-code-delivery') },
    { label: 'SMI interface', href: url('/features/smi-interface') },
  ],
};

const flatLinks = [
  { href: url('/docs'), label: 'Documentation' },
  { href: url('/app'), label: 'App' },
];

// Mobile nav: dropdowns + flat links in display order.
const mobileItems: MobileNavItem[] = [
  { type: 'dropdown', label: aboutDropdown.label, config: aboutDropdown },
  { type: 'dropdown', label: audiencesDropdown.label, config: audiencesDropdown },
  { type: 'dropdown', label: featuresDropdown.label, config: featuresDropdown },
  { type: 'link', label: 'Documentation', href: url('/docs') },
  { type: 'link', label: 'App', href: url('/app') },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  const current = pathname.replace(/\/$/, '') || '/';
  return current === normalized || current.startsWith(`${normalized}/`);
};

const FONT_URL =
  'https://fonts.googleapis.com/css2?' +
  'family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700' +
  '&family=IBM+Plex+Sans:wght@400;500;600;700' +
  '&family=IBM+Plex+Mono:wght@400;500;600' +
  '&display=swap';

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

const dropdowns = [aboutDropdown, audiencesDropdown, featuresDropdown];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Fonts: IBM Plex Sans/Mono + Fraunces (the design-system token stack) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONT_URL} />

    <!-- Favicon + theme color -->
    <link rel="icon" type="image/svg+xml" href={url('/img/oiml-logo_cnml-box-light.svg')} />
    <link rel="apple-touch-icon" href={url('/img/oiml-logo_cnml-box-light.svg')} />
    <meta name="theme-color" content="#004996" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph + Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={url('/img/oiml-logo.svg')} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- FOUC prevention: apply the saved theme before the stylesheet
         paints. The script is synchronous and runs before <body> renders.
         Reads localStorage; falls back to the OS preference. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('cnml-theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) { /* no-op */ }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:rounded focus:bg-[var(--ink)] focus:text-[var(--paper)]">
      Skip to content
    </a>
    <header class="cnml-site-header bg-[var(--paper-soft)] border-b border-[var(--rule)] sticky top-0 z-10">
      <div class="cnml-header-bar max-w-7xl mx-auto">
        <a href={url('/')} class="cnml-brand" aria-label="CNML home">
          <img src={url('/img/oiml-logo_cnml-box-light.svg')} alt="CNML" class="cnml-brand__logo cnml-brand__logo--light" />
          <img src={url('/img/oiml-logo_cnml-box-dark.svg')} alt="" aria-hidden="true" class="cnml-brand__logo cnml-brand__logo--dark" />
          <span>
            <span class="block cnml-brand__title">CNML</span>
            <span class="block cnml-brand__sub">Certificat Numérique · Métrologie Légale</span>
          </span>
        </a>
        <nav class="cnml-nav cnml-nav--desktop" aria-label="Primary">
          {dropdowns.map(d => (
            <NavDropdown client:load config={d} currentPath={pathname} />
          ))}
          {flatLinks.map(item => (
            <a href={item.href}
               class="cnml-nav__link"
               aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <ThemeToggle client:load />
        </nav>
        <div class="cnml-nav cnml-nav--mobile">
          <ThemeToggle client:load />
          <MobileNav client:load items={mobileItems} />
        </div>
      </div>
    </header>
    <main id="main" class="flex-1">
      <PilotWarning />
      <slot />
    </main>
    <footer class="border-t border-[var(--rule)] bg-[var(--paper-soft)]">
      <div class="max-w-7xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-4">
        <div class="cnml-colophon">
          CNML · OIML SMART programme · 2026 edition (proposal)
        </div>
        <div class="cnml-colophon flex flex-wrap gap-4">
          <a href="https://github.com/oimlsmart/cnml">Source</a>
          <a href="https://github.com/oimlsmart/styleguide/blob/main/WRITING_STYLE.md">Style guide</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Desktop nav shows on md and up; mobile nav shows below md. The
     MobileNav component's hamburger is hidden above 768px via its own
     scoped styles; here we hide the desktop nav below 768px. */
  @media (max-width: 768px) {
    .cnml-nav--desktop { display: none; }
  }
  @media (min-width: 769px) {
    .cnml-nav--mobile { display: none; }
  }
</style>
