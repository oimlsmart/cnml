---
import '../styles/global.css';
// Self-hosted fonts (TODO.cnml/28). The @fontsource packages ship
// open-license WOFF2 files and matching @font-face declarations.
// Astro bundles both into the static site, so no request leaves the
// origin on first paint. The previous setup leaked every page view
// to fonts.googleapis.com.
//
// That privacy decision is also why this layout mounts the shell's
// SiteHeader / SiteFooter directly instead of the package's Base:
// the package Base hardcodes a Google Fonts <link> ahead of the head
// slot, before any CSP meta can land, and the audit gate (the "no
// third-party font hosts" leg in test/audit) forbids third-party font
// hosts in the built output. The chrome, the injected-config contract,
// and the theme runtime still come from the package — only the html
// shell (head, fonts, CSP, the OG/JSON-LD payload the package Base
// does not carry) stays local.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import { SiteHeader, SiteFooter, THEME_BOOTSTRAP } from '@oimlsmart/site-shell';
import PilotWarning from '../components/PilotWarning.astro';
import LocaleToggle from '../components/LocaleToggle.vue';
import { BRAND } from '../data/brand';
import { NAV_MODEL } from '../data/nav-config';
import { FOOTER } from '../data/footer';
import { url } from '../lib/url';
import { jsonLdForPage } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  /** Path under public/ for the OG image. Defaults to the brand default. */
  ogImage?: string;
  /** Article metadata. When present, switches og:type to "article". */
  article?: {
    section: string;
    tags?: string[];
    publishedTime?: string;
    modifiedTime?: string;
  };
}

const {
  title = 'CNML',
  description = 'OIML Certificat Numérique de Métrologie Légale',
  ogImage,
  article,
} = Astro.props;
// Routes pass a page-level title (e.g., "Why CNML · Docs") without the
// site suffix; Base appends " · CNML" exactly once. The home page
// passes the bare title "CNML" and gets no suffix.
const pageTitle = title === 'CNML' ? title : `${title} · CNML`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImagePath = ogImage ?? '/img/og-default.svg';
const ogImageUrl = new URL(url(ogImagePath), Astro.site ?? Astro.url).toString();
const ogType = article ? 'article' : 'website';

// JSON-LD structured data for search engines (TODO.cnml/34). The
// builder picks the right type from the URL path; the `article` prop
// (when set) supplies section/tags.
const jsonLd = jsonLdForPage({
  path: Astro.url.pathname.replace(/^\/cnml/, '') || '/',
  title,
  description,
  imageUrl: ogImageUrl,
  article,
});

// Content-Security-Policy — built by the CSP module (testable).
// See lib/csp.ts for the dev/prod split rationale.
import { buildCsp } from '../lib/csp';
const csp = buildCsp({ dev: import.meta.env.DEV });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- No OIML SMART site is indexed: the noindex rides the meta tag on
         every page (the owner's standing directive — www, studio, recs,
         and smi carry the same tag). -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Favicon + theme color -->
    <link rel="icon" type="image/svg+xml" href={url('/img/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/img/favicon.svg')} />
    <link rel="manifest" href={url('/manifest.json')} />
    <meta name="theme-color" content="#004996" />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CNML" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Security headers. GitHub Pages does not support _headers;
         meta http-equiv is the available mechanism. -->
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Open Graph + Twitter Card -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="CNML" />
    {article && (
      <>
        <meta property="article:section" content={article.section} />
        {article.publishedTime && (
          <meta property="article:published_time" content={article.publishedTime} />
        )}
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime} />
        )}
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@oimlsmart" />

    <!-- Schema.org structured data (TODO.cnml/34). One builder picks
         the right type per page; consumers are Google, DuckDuckGo,
         aggregators. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- FOUC prevention: the shell's theme runtime owns dark-mode state
         (the theme contract — one storage key, .dark on <html>). The
         bootstrap is synchronous and runs before <body> renders. -->
    <script is:inline set:html={THEME_BOOTSTRAP} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:rounded focus:bg-[var(--ink)] focus:text-[var(--paper)]">
      Skip to content
    </a>
    <!-- The chrome is the package's (one chrome SSOT, TODO.ia/03 item
         5), fed this site's own injected config from src/data/. The
         locale toggle rides the header's identity slot: the site has
         no sign-in, so the slot carries it instead. -->
    <SiteHeader brand={BRAND} nav={NAV_MODEL} hasSignin={true}>
      <!-- The slot attribute rides a plain wrapper: on the island
           itself it leaks into Vue's hydration attrs and mismatches
           the server render. -->
      <span slot="signin" class="inline-flex items-center"><LocaleToggle client:idle /></span>
    </SiteHeader>
    <main id="main" class="flex-1">
      <PilotWarning />
      <slot />
    </main>
    <SiteFooter brand={BRAND} nav={NAV_MODEL} footer={FOOTER} />
  </body>
</html>
