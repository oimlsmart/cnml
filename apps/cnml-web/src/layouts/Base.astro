---
import '../styles/global.css';
// Self-hosted fonts (TODO.cnml/28). The @fontsource packages ship
// open-license WOFF2 files and matching @font-face declarations.
// Astro bundles both into the static site, so no request leaves the
// origin on first paint. The previous setup leaked every page view
// to fonts.googleapis.com.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import PilotWarning from '../components/PilotWarning.astro';
import NavDropdown from '../components/NavDropdown.vue';
import MobileNav from '../components/MobileNav.vue';
import ThemeToggle from '../components/ThemeToggle.vue';
import LocaleToggle from '../components/LocaleToggle.vue';
import { url } from '../lib/url';
import { jsonLdForPage } from '../lib/jsonld';
import {
  aboutDropdown,
  audiencesDropdown,
  featuresDropdown,
  flatLinks,
  mobileItems,
} from '../data/nav';

interface Props {
  title?: string;
  description?: string;
  /** Path under public/ for the OG image. Defaults to the brand default. */
  ogImage?: string;
  /** Article metadata. When present, switches og:type to "article". */
  article?: {
    section: string;
    tags?: string[];
    publishedTime?: string;
    modifiedTime?: string;
  };
}

const {
  title = 'CNML',
  description = 'OIML Certificat Numérique de Métrologie Légale',
  ogImage,
  article,
} = Astro.props;
// Routes pass a page-level title (e.g., "Why CNML · Docs") without the
// site suffix; Base appends " · CNML" exactly once. The home page
// passes the bare title "CNML" and gets no suffix.
const pageTitle = title === 'CNML' ? title : `${title} · CNML`;

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  const current = pathname.replace(/\/$/, '') || '/';
  return current === normalized || current.startsWith(`${normalized}/`);
};

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImagePath = ogImage ?? '/img/og-default.svg';
const ogImageUrl = new URL(url(ogImagePath), Astro.site ?? Astro.url).toString();
const ogType = article ? 'article' : 'website';

// JSON-LD structured data for search engines (TODO.cnml/34). The
// builder picks the right type from the URL path; the `article` prop
// (when set) supplies section/tags.
const jsonLd = jsonLdForPage({
  path: Astro.url.pathname.replace(/^\/cnml/, '') || '/',
  title,
  description,
  imageUrl: ogImageUrl,
  article,
});

const dropdowns = [aboutDropdown, audiencesDropdown, featuresDropdown];

// Content-Security-Policy. Two spec-driven constraints:
// - frame-ancestors, report-uri, sandbox are NOT enforceable via <meta>
//   (they require an HTTP header). Omitted rather than carrying dead
//   directives that give a false sense of protection.
// - In dev mode Astro injects inline scripts for HMR/hydration; the
//   production CSP (script-src 'self') would block them and flood the
//   console. Dev widens to 'unsafe-inline'; production stays strict.
const scriptSrc = import.meta.env.DEV
  ? "script-src 'self' 'unsafe-inline'"
  : "script-src 'self'";
const csp = `default-src 'self'; ${scriptSrc}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://www.oimlsmart.org; base-uri 'self'; form-action 'self'; object-src 'none';`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon + theme color -->
    <link rel="icon" type="image/svg+xml" href={url('/img/oiml-logo_cnml-box-light.svg')} />
    <link rel="apple-touch-icon" href={url('/img/oiml-logo_cnml-box-light.svg')} />
    <link rel="manifest" href={url('/manifest.json')} />
    <meta name="theme-color" content="#004996" />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CNML" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Security headers. GitHub Pages does not support _headers;
         meta http-equiv is the available mechanism. -->
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Open Graph + Twitter Card -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="CNML" />
    {article && (
      <>
        <meta property="article:section" content={article.section} />
        {article.publishedTime && (
          <meta property="article:published_time" content={article.publishedTime} />
        )}
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime} />
        )}
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@oimlsmart" />

    <!-- Schema.org structured data (TODO.cnml/34). One builder picks
         the right type per page; consumers are Google, DuckDuckGo,
         aggregators. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- FOUC prevention: apply the saved theme before the stylesheet
         paints. The script is synchronous and runs before <body> renders.
         Reads localStorage; falls back to the OS preference. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('cnml-theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) { /* no-op */ }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:rounded focus:bg-[var(--ink)] focus:text-[var(--paper)]">
      Skip to content
    </a>
    <header class="cnml-site-header bg-[var(--paper-soft)] border-b border-[var(--rule)] sticky top-0 z-10">
      <div class="cnml-header-bar max-w-7xl mx-auto">
        <a href={url('/')} class="cnml-brand" aria-label="CNML home">
          <img src={url('/img/oiml-logo_cnml-box-light.svg')} alt="CNML" class="cnml-brand__logo cnml-brand__logo--light" />
          <img src={url('/img/oiml-logo_cnml-box-dark.svg')} alt="" aria-hidden="true" class="cnml-brand__logo cnml-brand__logo--dark" />
          <span>
            <span class="block cnml-brand__title">CNML</span>
            <span class="block cnml-brand__sub">Certificat Numérique · Métrologie Légale</span>
          </span>
        </a>
        <nav class="cnml-nav cnml-nav--desktop" aria-label="Primary">
          {dropdowns.map(d => (
            <NavDropdown client:load config={d} currentPath={pathname} />
          ))}
          {flatLinks.map(item => (
            <a href={item.href}
               class="cnml-nav__link"
               aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <ThemeToggle client:load />
        </nav>
        <div class="cnml-nav cnml-nav--mobile">
          <ThemeToggle client:load />
          <MobileNav client:load items={mobileItems} />
        </div>
      </div>
    </header>
    <main id="main" class="flex-1">
      <PilotWarning />
      <slot />
    </main>
    <footer class="border-t border-[var(--rule)] bg-[var(--paper-soft)]">
      <div class="max-w-7xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-4">
        <div class="cnml-colophon">
          CNML · OIML SMART programme · 2026 edition (proposal)
        </div>
        <div class="cnml-colophon flex flex-wrap items-center gap-4">
          <LocaleToggle client:idle />
          <a href="https://github.com/oimlsmart/cnml">Source</a>
          <a href="https://github.com/oimlsmart/styleguide/blob/main/WRITING_STYLE.md">Style guide</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Desktop nav shows on md and up; mobile nav shows below md. The
     MobileNav component's hamburger is hidden above 768px via its own
     scoped styles; here we hide the desktop nav below 768px. */
  @media (max-width: 768px) {
    .cnml-nav--desktop { display: none; }
  }
  @media (min-width: 769px) {
    .cnml-nav--mobile { display: none; }
  }
</style>
