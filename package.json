{
  "name": "cnml-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter cnml-web dev",
    "build": "pnpm --filter cnml-web build && node --experimental-strip-types --no-warnings scripts/audience-build.ts && pagefind --site apps/cnml-web/dist",
    "gen:types": "node --experimental-strip-types --no-warnings scripts/generate-types.ts",
    "gen:schemas": "node --experimental-strip-types --no-warnings scripts/generate-schemas-index.ts",
    "gen": "pnpm gen:schemas && pnpm gen:types && pnpm gen:glossary",
    "preview": "pnpm --filter cnml-web preview",
    "test": "pnpm --filter @oiml/cnml-test-vectors test",
    "test:crypto": "pnpm --filter @oiml/cnml-crypto test",
    "test:web": "pnpm --filter cnml-web test",
    "test:vitest": "pnpm --filter cnml-web test:vitest",
    "gen:glossary": "node --experimental-strip-types --no-warnings scripts/build-glossary.ts",
    "test:audit": "pnpm --filter cnml-web test:audit",
    "test:e2e": "playwright test --config=playwright.config.cjs",
    "test:e2e:headed": "playwright test --config=playwright.config.cjs --headed",
    "audit:links": "node --experimental-strip-types --no-warnings scripts/audit-links.ts",
    "audit:pages": "node --experimental-strip-types --no-warnings scripts/audit-pages.ts",
    "lint:style": "node --experimental-strip-types --no-warnings scripts/styleguide-lint.ts",
    "test:lint": "node --test --experimental-strip-types --no-warnings scripts/styleguide-lint.test.ts",
    "budget": "node --experimental-strip-types --no-warnings scripts/bundle-budget.ts",
    "vectors:gen": "pnpm --filter @oiml/cnml-test-vectors gen",
    "vectors:verify": "pnpm --filter @oiml/cnml-test-vectors verify",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke-test.mjs",
    "audience:build": "node --experimental-strip-types --no-warnings scripts/audience-build.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "links:check": "node --experimental-strip-types --no-warnings scripts/check-external-links.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "shiki": "^4.4.1",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "yaml": "^2.6.0"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/post-quantum": "^0.6.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.9.10",
    "asn1js": "^3.0.10",
    "isomorphic-dompurify": "^3.21.0",
    "pkijs": "^3.4.0",
    "qrcode": "^1.5.4",
    "xmldsigjs": "^2.8.7"
  }
}
