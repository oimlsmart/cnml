{
  "ci": {
    "collect": {
      "startServerCommand": "sh -c 'rm -rf /tmp/lh-stage && mkdir -p /tmp/lh-stage/cnml && cp -r apps/cnml-web/dist/* /tmp/lh-stage/cnml/ && npx --yes http-server /tmp/lh-stage -p 4321'",
      "startServerReadyPattern": "Available on|Started",
      "url": [
        "http://127.0.0.1:4321/cnml/",
        "http://127.0.0.1:4321/cnml/docs/why-cnml",
        "http://127.0.0.1:4321/cnml/verify"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1.0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}